---
import { effects, type EffectType } from '../data/effects';
import { pageCss } from '../utils/pageCss';

interface Props {
  title?: string;
  description?: string;
  /** extra schema.org nodes, merged into the page's JSON-LD @graph */
  schema?: Record<string, unknown>[];
  ogType?: 'website' | 'article';
  /** effects rendered on the page; only their CSS is inlined (default: all) */
  styles?: readonly EffectType[];
}

const {
  title = `CSS Text Effects — ${effects.length} pure-CSS text animations, free to copy`,
  description = `A library of ${effects.length} animated text effects built with pure CSS — gradient, glitch, typewriter, neon, liquid fill and more. Click any effect to copy its CSS. No JavaScript, no dependencies, MIT licensed.`,
  schema = [],
  ogType = 'website',
  styles = effects.map((e) => e.type),
} = Astro.props;

// Absolute URLs for canonical + social tags. Astro.site is configured in
// astro.config.mjs; fall back to the production origin during dev.
const SITE = Astro.site ?? new URL('https://text-effects.colorion.co');
const canonical = new URL(Astro.url.pathname, SITE).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${SITE.href}#website`,
      name: 'CSS Text Effects',
      url: SITE.href,
    },
    ...schema,
  ],
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    <meta name="theme-color" content="#08070F" />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />

    <!-- Decide enhancement and saved sidebar geometry before the first paint. -->
    <script is:inline>
      document.documentElement.classList.add('js');
      try {
        document.documentElement.classList.toggle('sidebar-collapsed', localStorage.getItem('colorion-sidebar-collapsed') === '1');
      } catch {}
    </script>

    <!-- Site chrome + only the effects this page renders (see utils/pageCss.ts) -->
    <style is:inline set:html={pageCss(styles)}></style>

    <!-- Favicons + PWA manifest -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="CSS Text Effects" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={new URL('/og-image.png', SITE).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/og-image.png', SITE).href} />

    <!-- Structured data -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

    <!-- Preload the hero, body and navigation faces. Optional font display keeps
         the matched fallback for this visit if a face arrives after first layout. -->
    <link rel="preload" as="font" type="font/woff2" href="/fonts/inter-latin-500-normal.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/inter-latin-400-normal.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/jetbrains-mono-latin-600-normal.woff2" crossorigin />

    <!-- Privacy-friendly analytics by Plausible -->
    <script async is:inline src="https://plausible.elerion.com/js/pa-4W7kNHJcWKuw1loNX79vh.js"></script>
    <script is:inline>
      window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
      plausible.init()
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
