---
// House ad for Iconbar, shown as one card in the home page effect grid.
const url = 'https://tablericons.com/iconbar/';
---

<aside class="cell ad-cell" aria-label="Sponsored: Iconbar">
  <span class="cell-index mono">Ad</span>
  <div class="stage ad-stage" aria-hidden="true">
    <span class="ad-keys mono"><kbd>⌃</kbd><kbd>⌥</kbd><kbd>I</kbd></span>
    <span class="ad-icons">
      <svg viewBox="0 0 24 24"><path d="M19.5 12.57 12 20l-7.5-7.43A5 5 0 1 1 12 6.01a5 5 0 1 1 7.5 6.57" /></svg>
      <svg viewBox="0 0 24 24"><path d="M13 3v7h6l-8 11v-7H5l8-11" /></svg>
      <svg viewBox="0 0 24 24"><path d="M6.66 18.5A4.5 4.5 0 0 1 6.5 9.5a5.5 5.5 0 0 1 10.6-1.4 4.5 4.5 0 0 1 .6 8.9H6.66z" /></svg>
      <svg viewBox="0 0 24 24"><path d="M12 17.75l-6.17 3.24 1.18-6.87-5-4.86 6.9-1L12 2l3.09 6.26 6.9 1-5 4.86 1.18 6.87z" /></svg>
    </span>
  </div>
  <h3>
    <a
      class="cell-link plausible-event-name=Iconbar+click"
      href={url}
      target="_blank"
      rel="noopener sponsored"
    >
      Iconbar for Mac
      <span class="cell-keyword">5,000+ Tabler icons in your menu bar. Paste as SVG, JSX or Vue.</span>
    </a>
  </h3>
  <span class="ad-cta mono" aria-hidden="true">Free trial →</span>
</aside>
