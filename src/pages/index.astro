---
import Layout from '../layouts/Layout.astro';
import Effect from '../components/Effect.astro';
import Sidebar from '../components/Sidebar.astro';
import { effects } from '../data/effects';
import { effectPath, effectSeo } from '../data/seo';

// The CSS snippets + LLM prompts are emitted as a static /effect-data.json file
// (see effect-data.json.ts) and fetched on demand when the modal first opens,
// so that text stays out of the initial HTML document.

const SITE = Astro.site ?? new URL('https://text-effects.colorion.co');
const schema = [
  {
    '@type': 'CollectionPage',
    '@id': `${SITE.href}#library`,
    name: 'CSS Text Effects',
    url: SITE.href,
    isPartOf: { '@id': `${SITE.href}#website` },
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: effects.length,
      itemListElement: effects.map((effect, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: effectSeo(effect).keyword,
        url: new URL(effectPath(effect), SITE).href,
      })),
    },
  },
];
---

<Layout schema={schema}>
  <Sidebar />

  <div class="page-shell">
    <header class="site-header">
      <div class="header-status mono">
        <span class="pulse-dot"></span>
        {effects.length} effects · MIT
      </div>
    </header>

    <section class="hero">
      <span class="hero-tag mono">Pure CSS · Copy &amp; paste</span>
      <h1>{effects.length} <em>CSS text effects</em>,<br />free to copy.</h1>
      <p>
        A library of {effects.length} animated text effects built with pure CSS —
        aurora gradients, glitches, split-flap boards, liquid fills and other
        lesser-seen tricks. No JavaScript, no dependencies. Copy the
        self-contained <code>CSS</code> for any effect, or grab a ready-made
        <code>Prompt</code> to have your coding agent recreate it. Every snippet
        paints with the <code>--ink</code> colour tokens and respects
        <code>prefers-reduced-motion</code>.
      </p>
    </section>

    <main class="library">
      <div class="panel">
        <h2 class="sr-only">Text effect library</h2>
        <div class="library-head">
          <span class="mono">Click an effect for its code &amp; guide · Prompt / CSS for a quick copy</span>
          <span class="mono">{effects.length} effects</span>
        </div>

        <div class="grid" id="effect-grid">
        {
          effects.map((effect) => (
            <article
              class="cell"
              data-type={effect.type}
              data-name={effect.name}
              data-index={effect.index}
              data-slug={effectSeo(effect).slug}
            >
              <span class="cell-index mono">{effect.index}</span>
              <div class="cell-actions">
                <button class="cell-action mono" type="button" data-action="prompt" aria-label={`Copy LLM prompt for ${effect.name} text effect`}><span aria-hidden="true">◳</span> Prompt</button>
                <button class="cell-action mono" type="button" data-action="css" aria-label={`View CSS for ${effect.name} text effect`}><span aria-hidden="true">⧉</span> CSS</button>
              </div>
              <div class="stage">
                <Effect type={effect.type} text={effect.text} />
              </div>
              <h3>
                <a class="cell-link" href={effectPath(effect)}>
                  {effect.name}
                  <span class="cell-keyword">{effectSeo(effect).keyword}</span>
                </a>
              </h3>
            </article>
          ))
        }
        </div>

      </div>
    </main>

    <footer class="site-footer">
      <span class="mono">CSS Text Effects</span>
      <nav class="footer-links mono">
        <a href="https://github.com/ckissi/colorion-text-effects" target="_blank" rel="noopener">GitHub</a>
      </nav>
      <span class="mono">Pure CSS · No dependencies · MIT licensed</span>
      <a class="footer-badge" href="https://sevalla.com?ref=text-effects.colorion.co" target="_blank" rel="noopener">
        <img src="/hosted-on-sevalla.png" alt="Hosted on Sevalla" width="230" height="73" loading="lazy" />
      </a>
    </footer>

    <!-- Copy-to-clipboard modal -->
    <div class="modal-overlay" id="css-modal" hidden>
      <div class="modal" role="dialog" aria-modal="true" aria-labelledby="modal-title">
        <div class="modal-head">
          <div class="modal-title-group">
            <span class="modal-index mono" id="modal-index"></span>
            <h2 class="modal-title mono" id="modal-title"></h2>
          </div>
          <button class="modal-close mono" id="modal-close" aria-label="Close">✕</button>
        </div>
        <div class="modal-preview">
          <div class="stage" id="modal-preview"></div>
        </div>
        <div class="modal-code-wrap">
          <pre class="modal-code"><code id="modal-code"></code></pre>
        </div>
        <div class="modal-foot">
          <a
            class="modal-credit"
            href="https://x.com/domi_kissi"
            target="_blank"
            rel="noopener"
          >
            <img src="/domi.jpg" alt="" width="32" height="32" />
            <span>Design inspiration by @domi_kissi.</span>
          </a>
          <div class="modal-actions">
            <a class="modal-page mono" id="modal-page" href="/">Full page →</a>
            <button class="modal-copy mono" id="modal-copy">Copy CSS</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  const cells = Array.from(document.querySelectorAll<HTMLElement>('.cell'));

  // Every card is in the HTML (so crawlers and no-JS visitors see all of them);
  // .cell's content-visibility: auto skips rendering far-offscreen ones. Mark
  // lazy mode active so CSS pauses animations of cells outside the viewport.
  document.documentElement.classList.add('lazy-enabled');

  const visibility = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        entry.target.classList.toggle('in-view', entry.isIntersecting);
      }
    },
    { rootMargin: '100px' }
  );
  cells.forEach((cell) => visibility.observe(cell));

  // Remember the grid scroll position so returning from an effect page (Back
  // or Esc) lands on the same card, even if native restoration ran before the
  // page reached its full height.
  const SCROLL_KEY = 'library-scroll';
  window.addEventListener('pagehide', () => {
    try {
      sessionStorage.setItem(SCROLL_KEY, String(scrollY));
    } catch {
      // storage unavailable — native restoration still applies
    }
  });
  const nav = performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined;
  const isBackForward = nav?.type === 'back_forward';
  if (isBackForward) {
    try {
      const saved = Number(sessionStorage.getItem(SCROLL_KEY));
      if (saved && Math.abs(scrollY - saved) > 50) scrollTo(0, saved);
    } catch {
      // ignore
    }
  }

  // Esc on an effect page sends the visitor here with the card to return to.
  try {
    const returnSlug = sessionStorage.getItem('library-return');
    sessionStorage.removeItem('library-return');
    const card = returnSlug && cells.find((c) => c.dataset.slug === returnSlug);
    if (card) {
      requestAnimationFrame(() => {
        card.scrollIntoView({ block: 'center' });
        card.querySelector<HTMLElement>('.cell-link')?.focus({ preventScroll: true });
      });
    }
  } catch {
    // ignore
  }

  // ---------- Copy-to-clipboard modal ----------
  type Mode = 'css' | 'prompt';
  type EffectData = { snippets: Record<string, string>; prompts: Record<string, string> };

  // The CSS snippets + LLM prompts live in a static JSON file rather than inline,
  // so they don't bloat the document. Fetched once, on first use.
  let dataPromise: Promise<EffectData> | undefined;
  const loadData = () =>
    (dataPromise ??= fetch('/effect-data.json', { cache: 'no-store' }).then(async (r) => {
      if (!r.ok) throw new Error(`effect-data.json ${r.status}`);
      return r.json() as Promise<EffectData>;
    }));

  const MODE_CONFIG: Record<Mode, { key: keyof EffectData; copyLabel: string }> = {
    css: { key: 'snippets', copyLabel: 'Copy CSS' },
    prompt: { key: 'prompts', copyLabel: 'Copy prompt' },
  };

  // Warm the cache as soon as the user signals intent (pointer over the grid).
  const grid = document.getElementById('effect-grid');
  grid?.addEventListener('pointerenter', loadData, { once: true });

  const overlay = document.getElementById('css-modal')!;
  const modalIndex = document.getElementById('modal-index')!;
  const modalTitle = document.getElementById('modal-title')!;
  const modalPreview = document.getElementById('modal-preview')!;
  const modalCode = document.getElementById('modal-code')!;
  const copyBtn = document.getElementById('modal-copy') as HTMLButtonElement;
  const closeBtn = document.getElementById('modal-close')!;
  const pageLink = document.getElementById('modal-page') as HTMLAnchorElement;

  // Plausible custom events (no-op if the script is blocked). Register the
  // "Copy" and "Open effect page" goals in Plausible to see them.
  const track = (event: string, props: Record<string, string>) =>
    (window as { plausible?: (e: string, o: object) => void }).plausible?.(event, { props });

  let lastFocused: HTMLElement | null = null;
  let copyReset: number | undefined;
  let currentMode: Mode = 'css';
  let currentText = ''; // the copyable text for the open modal ('' while loading)
  let openToken = 0; // guards against races when switching effects mid-fetch

  async function openModal(cell: HTMLElement, mode: Mode = 'css') {
    const type = cell.dataset.type!;
    const config = MODE_CONFIG[mode];
    const token = ++openToken;

    // Show the modal shell immediately; the code text fills in once data loads.
    currentMode = mode;
    currentText = '';
    modalIndex.textContent = cell.dataset.index || '';
    modalTitle.textContent = cell.dataset.name || '';
    pageLink.href = `/effects/${cell.dataset.slug}/`;
    // Deep link: /#<slug> reopens this effect. A hash (not a path) keeps it from
    // competing with the effect's own page in search.
    history.replaceState(null, '', `#${cell.dataset.slug}`);
    modalCode.textContent = 'Loading…';

    // clone the live effect for the preview
    const effectEl = cell.querySelector('.stage > *');
    modalPreview.replaceChildren(effectEl ? effectEl.cloneNode(true) : document.createTextNode(''));

    copyBtn.textContent = config.copyLabel;
    copyBtn.classList.remove('copied');

    lastFocused = document.activeElement instanceof HTMLElement ? document.activeElement : null;
    overlay.removeAttribute('hidden');
    document.body.style.overflow = 'hidden';
    copyBtn.focus();

    let text = '';
    try {
      text = (await loadData())[config.key][type] || '';
    } catch {
      text = '';
    }
    if (token !== openToken) return; // a newer open superseded this one
    currentText = text;
    modalCode.textContent = text || 'Failed to load — please try again.';
  }

  function closeModal() {
    overlay.setAttribute('hidden', '');
    document.body.style.overflow = '';
    modalPreview.replaceChildren();
    history.replaceState(null, '', location.pathname + location.search);
    lastFocused?.focus();
  }

  async function copyCss() {
    const text = currentText;
    if (!text) return; // data not loaded yet (or failed) — nothing to copy
    try {
      await navigator.clipboard.writeText(text);
    } catch {
      // fallback for non-secure contexts
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.select();
      document.execCommand('copy');
      ta.remove();
    }
    track('Copy', { effect: modalTitle.textContent || '', mode: currentMode, from: 'modal' });
    copyBtn.textContent = 'Copied ✓';
    copyBtn.classList.add('copied');
    window.clearTimeout(copyReset);
    copyReset = window.setTimeout(() => {
      copyBtn.textContent = MODE_CONFIG[currentMode].copyLabel;
      copyBtn.classList.remove('copied');
    }, 1800);
  }

  // The card itself is a link to the effect's page (the name's stretched
  // ::after); only the Prompt / CSS buttons open the quick-copy modal.
  cells.forEach((cell) => {
    cell.querySelectorAll<HTMLButtonElement>('[data-action]').forEach((btn) => {
      btn.addEventListener('click', () => openModal(cell, btn.dataset.action === 'prompt' ? 'prompt' : 'css'));
    });
  });

  copyBtn.addEventListener('click', copyCss);
  pageLink.addEventListener('click', () => {
    track('Open effect page', { effect: modalTitle.textContent || '' });
    // close first so this history entry is a clean "/" (no #hash that would
    // reopen the modal when the visitor comes back)
    closeModal();
  });
  closeBtn.addEventListener('click', closeModal);
  overlay.addEventListener('click', (e) => {
    if (e.target === overlay) closeModal();
  });
  // The modal takes priority over the sidebar and page shortcuts.
  window.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape' || e.defaultPrevented || e.isComposing || overlay.hasAttribute('hidden')) return;
    e.preventDefault();
    if (!e.repeat) closeModal();
  }, { capture: true });

  // Open the effect named in the URL hash, on load and on in-page hash changes.
  // Only on a fresh visit — coming Back to an entry that still has a hash
  // should not pop the modal open again.
  const openFromHash = () => {
    const slug = decodeURIComponent(location.hash.slice(1));
    const cell = slug && cells.find((c) => c.dataset.slug === slug);
    if (cell) openModal(cell);
  };
  if (!isBackForward) openFromHash();
  else if (location.hash) history.replaceState(null, '', location.pathname + location.search);
  window.addEventListener('hashchange', openFromHash);
  // bfcache restores the page exactly as it was left — close a modal left open
  window.addEventListener('pageshow', (e) => {
    if (e.persisted && !overlay.hasAttribute('hidden')) closeModal();
  });

</script>
