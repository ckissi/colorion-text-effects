---
import Layout from '../layouts/Layout.astro';
import EffectCard from '../components/EffectCard.astro';
import CategoryNav from '../components/CategoryNav.astro';
import Sidebar from '../components/Sidebar.astro';
import CodeExample from '../components/CodeExample.astro';
import { effects, perLetter, usesDataText } from '../data/effects';
import { categoryGuides } from '../data/categoryGuides';
import { guides } from '../utils/effectGuide';
import { categories, categoryOrder, categoryPath, effectPath, effectSeo, effectsIn, type Category } from '../data/seo';

export function getStaticPaths() {
  return categoryOrder.map((category) => ({ params: { category: categories[category].slug }, props: { category } }));
}

interface Props {
  category: Category;
}

const { category } = Astro.props;
const info = categories[category];
const guide = categoryGuides[category];
const comparisons = guide.comparisons.map((row) => {
  const effect = effects.find((e) => e.type === row.type);
  if (!effect || effectSeo(effect).category !== category) throw new Error(`Invalid ${category} comparison: ${row.type}`);
  return { ...row, effect, loop: guides.get(effect)!.loopSeconds };
});
const list = effectsIn(category);
const n = list.length;

const title =
  [`${n} ${info.heading} — Free Copy & Paste Code`, `${n} ${info.heading} — Free Code`, `${n} ${info.heading}`].find(
    (t) => t.length <= 60
  ) ?? info.heading;
// "Retro CSS Text Effects" → "retro text effects" (the sentence already says "pure CSS")
const phrase = info.heading.replace(/\bCSS /, '').toLowerCase().replace(/\b3d\b/g, '3D');
const summary = info.summary.replace(/\s*(?:built with|in) pure CSS\.$/, '.');
const description =
  [
    `${n} free ${phrase} made with pure CSS. ${summary} No JavaScript — copy the HTML and CSS or an AI prompt.`,
    `${n} free ${phrase} in pure CSS. ${summary} No JavaScript, just copy & paste.`,
  ].find((d) => d.length <= 155) ?? `${n} free ${phrase} in pure CSS. ${summary}`;

const SITE = Astro.site ?? new URL('https://text-effects.colorion.co');
const url = new URL(categoryPath(category), SITE).href;
const schema = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'CSS Text Effects', item: SITE.href },
      { '@type': 'ListItem', position: 2, name: info.heading, item: url },
    ],
  },
  {
    '@type': 'CollectionPage',
    name: info.heading,
    description,
    url,
    isPartOf: { '@id': `${SITE.href}#website` },
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: n,
      itemListElement: list.map((effect, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: effectSeo(effect).keyword,
        url: new URL(effectPath(effect), SITE).href,
      })),
    },
  },
];
---

<Layout title={title} description={description} schema={schema} styles={list.map((e) => e.type)}>
  <Sidebar />

  <div class="page-shell">
    <header class="site-header effect-header">
      <nav class="breadcrumbs mono" aria-label="Breadcrumb">
        <a href="/">CSS Text Effects</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{info.heading}</span>
      </nav>
      <div class="header-status mono">
        <span class="pulse-dot"></span>
        {n} effects
      </div>
    </header>

    <section class="hero effect-hero">
      <span class="hero-tag mono">Pure CSS · No JavaScript · MIT</span>
      <h1>{n} <em>{info.heading}</em></h1>
      {info.intro.map((p) => <p>{p}</p>)}
    </section>

    <main class="library">
      <CategoryNav current={category} />
      <div class="panel">
        <h2 class="sr-only">{info.heading}</h2>
        <div class="library-head">
          <span class="mono">Click an effect for its code &amp; guide</span>
          <span class="mono">{n} effects</span>
        </div>
        <div class="grid">
          {list.map((effect) => <EffectCard effect={effect} />)}
        </div>
      </div>

      <div class="category-guide">
        <section class="effect-section" aria-labelledby="choosing-title">
          <h2 id="choosing-title">Choosing {info.heading.toLowerCase().replace(/\bcss\b/g, 'CSS').replace(/\b3d\b/g, '3D')}</h2>
          <p>{guide.choosing}</p>
          <div class="comparison-wrap" role="region" aria-label="Compare text effects" tabindex="0">
            <table class="effect-comparison">
              <caption>Three styles to start with</caption>
              <thead><tr><th scope="col">Effect</th><th scope="col">Best for</th><th scope="col">Markup / loop</th><th scope="col">What to consider</th></tr></thead>
              <tbody>
                {comparisons.map(({ effect, bestFor, tradeoff, loop }) => (
                  <tr>
                    <th scope="row"><a href={effectPath(effect)}>{effectSeo(effect).keyword}</a></th>
                    <td>{bestFor}</td>
                    <td>{perLetter.has(effect.type) ? 'Indexed letters' : usesDataText.has(effect.type) ? 'One element + data-text' : 'One text element'}<br />{loop ? `${+loop.toFixed(2)}s loop` : 'Static'}</td>
                    <td>{tradeoff}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
        <section class="effect-section" aria-labelledby="example-title">
          <h2 id="example-title">{guide.example.title}</h2>
          <p>{guide.example.explanation}</p>
          <CodeExample markup={guide.example.markup} css={guide.example.css} />
        </section>
        <section class="effect-section" aria-labelledby="questions-title">
          <h2 id="questions-title">Before you use these effects</h2>
          {guide.questions.map(({ question, answer }) => (
            <div class="guide-answer"><h3>{question}</h3><p>{answer}</p></div>
          ))}
          <p>Ready to adapt a style? <a href={`/text-effect-generator/?effect=${effectSeo(comparisons[0].effect).slug}`}>Try your own text and colours in the generator</a>, or open a guide above for the complete implementation.</p>
        </section>
      </div>
    </main>

    <footer class="site-footer">
      <span class="mono">CSS Text Effects</span>
      <nav class="footer-links mono">
        <a href="https://github.com/ckissi/colorion-text-effects" target="_blank" rel="noopener">GitHub</a>
      </nav>
      <span class="mono">Pure CSS · No dependencies · MIT licensed</span>
    </footer>
  </div>
</Layout>
